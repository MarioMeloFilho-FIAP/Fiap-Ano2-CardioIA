# CardioIA — Fase 5: variáveis de ambiente do assistente
# Copie para "chatbot/.env" e preencha SOMENTE o que for usar.
# NUNCA versione o .env com valores reais (já está no .gitignore).

# --- Servidor ---
CHATBOT_PORT=5001
# CHATBOT_CONFIANCA_MINIMA=0.30
# CHATBOT_DB=chatbot_conversas.db

# --- IBM Watson Assistant (opcional) ---
# Sem estas variáveis, o assistente usa o motor NLU LOCAL (mesmo skill_cardio.json).
# WA_API_KEY=
# WA_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/xxxx
# WA_ASSISTANT_ID=
# WA_VERSION=2021-11-27

# --- Camada NLG / LLM (opcional, NEUTRA de provedor) ---
# Se LLM_PROVIDER ficar vazio, o provedor é auto-detectado pela chave presente.
# LLM_PROVIDER=openai        # openai | anthropic | gemini
# LLM_MODEL=                 # sobrescreve o modelo padrão do provedor
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
